# Cobalt Engine Environment Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite:///./data/cobalt.db

# LLM Configuration (optional, opt-in)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Keycloak/OIDC (required for production)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cobalt
KEYCLOAK_CLIENT_ID=cobalt-engine
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=cobalt
VITE_KEYCLOAK_CLIENT_ID=cobalt-engine

# Demo mode (LOCALHOST ONLY - REFUSED IN PRODUCTION)
DEMO_MODE=false